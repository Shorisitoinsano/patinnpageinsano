---
import T from '../ui/T.astro';
/** Retrato: paisaje nocturno (el bosque se dibuja una vez y se refleja) + ficha con código de barras. */
const forest = `<polygon points="30,90 14,195 46,195"></polygon><polygon points="30,148.8 8.399999999999999,274.8 51.6,274.8"></polygon><rect x="27" y="270.6" width="6" height="29.400000000000002"></rect><polygon points="78,150 64,225 92,225"></polygon><polygon points="78,192 59.099999999999994,282 96.9,282"></polygon><rect x="75" y="279" width="6" height="21.000000000000004"></rect><polygon points="128,50 110,175 146,175"></polygon><polygon points="128,120 103.7,270 152.3,270"></polygon><rect x="125" y="265" width="6" height="35"></rect><polygon points="185,130 170,215 200,215"></polygon><polygon points="185,177.60000000000002 164.75,279.6 205.25,279.6"></polygon><rect x="182" y="276.2" width="6" height="23.8"></rect><polygon points="240,70 223,185 257,185"></polygon><polygon points="240,134.4 217.05,272.4 262.95,272.4"></polygon><rect x="237" y="267.8" width="6" height="32.2"></rect><polygon points="296,160 283,230 309,230"></polygon><polygon points="296,199.2 278.45,283.2 313.55,283.2"></polygon><rect x="293" y="280.4" width="6" height="19.6"></rect><polygon points="345,100 329,200 361,200"></polygon><polygon points="345,156 323.4,276 366.6,276"></polygon><rect x="342" y="272" width="6" height="28.000000000000004"></rect><polygon points="386,140 374,220 398,220"></polygon><polygon points="386,184.8 369.8,280.8 402.2,280.8"></polygon><rect x="383" y="277.6" width="6" height="22.400000000000002"></rect>`;
const bars: Array<[number, number]> = [[0,4],[5,2],[10,2],[13,1],[16,3],[20,1],[22,2],[26,1],[29,1],[33,2],[37,3],[43,3],[49,1],[51,4],[58,3],[63,4],[69,4],[74,2],[79,2],[82,1],[85,3],[89,1],[91,2],[95,1],[98,1],[102,2],[106,3],[112,3],[118,1],[120,4],[127,3],[132,4],[138,4],[143,2]];
---
<section class="cv mx-auto mt-12 grid max-w-6xl gap-0 px-4 md:grid-cols-[55fr_45fr]" aria-label="Retrato">
<figure class="rv relative min-h-[360px] overflow-hidden border-2 border-ink md:min-h-[640px]"><svg viewBox="0 0 400 560" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 h-full w-full" role="img" aria-label="Paisaje nocturno de árboles delgados con su reflejo en el agua"><defs><linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--blue-deep)"></stop><stop offset="1" stop-color="var(--blue)"></stop></linearGradient><pattern id="dots" width="6" height="6" patternUnits="userSpaceOnUse"><circle cx="3" cy="3" r="1" fill="var(--on-blue)"></circle></pattern></defs>
<rect width="400" height="300" fill="url(#sky)"></rect><rect width="400" height="300" fill="url(#dots)" opacity=".12"></rect><circle cx="292" cy="92" r="38" fill="var(--paper)"></circle><circle cx="304" cy="84" r="34" fill="var(--blue-deep)" opacity=".35"></circle>
<g fill="var(--ink)" set:html={forest}></g><rect y="300" width="400" height="260" fill="var(--blue-deep)"></rect><g fill="var(--ink)" opacity=".5" transform="translate(0 600) scale(1 -1)" set:html={forest}></g><circle cx="292" cy="508" r="38" fill="var(--paper)" opacity=".25"></circle></svg>
<figcaption class="lbl absolute bottom-4 left-4 bg-deep px-2 py-1 text-onblue">FIG. 01 — <T es="BOSQUE / REFLEJO" en="FOREST / REFLECTION" /></figcaption></figure>
<div class="rv flex flex-col gap-4 border-2 border-ink bg-paper p-6 md:border-l-0"><div class="flex items-center justify-between"><svg viewBox="0 0 148 44" class="barcode h-11 w-40" aria-hidden="true">{bars.map(([x, w]) => <rect x={x} y="0" width={w} height="44" fill="var(--ink)"></rect>)}</svg><span class="lbl">No. 0472</span></div>
<p class="lbl border-y border-ink py-2"><T es="Archivo 07 · Señal de noche" en="File 07 · Night signal" /></p>
<p class="disp text-[clamp(56px,9vw,110px)] leading-[.85]"><T es="Noche" en="Night" /></p>
<div class="flex items-center gap-4"><svg viewBox="0 0 120 120" class="tw h-20 w-20 shrink-0" aria-hidden="true"><use href="#compass"></use></svg><p class="lbl"><T es="Estrella-brújula: siempre apunto hacia donde hay menos luz." en="Compass star: I always point where there’s less light." /></p></div>
<p class="disp text-[clamp(56px,9vw,110px)] italic leading-[.85]"><T es="Tinta" en="Ink" /></p>
<p><T es="Me podría considerar una especie de ilustrador. Siempre me ha gustado el blanco y negro junto a colores súper saturados, como el azul de esta página o el rojo, y suelo trabajar con paletas análogas. Dibujo de noche, porque de día hago otras cosas que me agotan la cabeza. Mi lugar favorito: la cama, dibujando cualquier cosa." en="I could call myself some kind of illustrator. I’ve always loved black and white next to super saturated colours, like this page’s blue or red, and I usually work with analogous palettes. I draw at night, because during the day I do other things that wear my head out. My favourite place: my bed, drawing whatever." /></p></div></section>
