---
import T from '../ui/T.astro';
import SectionTitle from '../ui/SectionTitle.astro';
---
<section class="cv mx-auto max-w-6xl px-4 pb-24" aria-labelledby="exp"><div class="mb-8 flex items-end justify-between"><SectionTitle id="exp" es="Explora" en="Explore" /><span class="lbl">02 — 03 — 04</span></div>
<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"><li class="rv"><a href="/sobre-mi" class="cut bg-cobalt text-onblue group relative block min-h-60 border-2 border-ink p-6"><span class="ht ht-layer"></span><span class="lbl relative">02</span><span class="disp relative mt-10 block text-5xl leading-none"><T es="Sobre mí" en="About me" /></span><span class="relative mt-4 block max-w-[24ch] text-[15px]"><T es="Quién soy, cómo trabajo y cómo es mi día." en="Who I am, how I work and what my day looks like." /></span><span class="lbl relative mt-6 block transition-transform group-hover:translate-x-2" aria-hidden="true">→</span></a></li><li class="rv"><a href="/gustos" class="cut2 bg-paper2 group relative block min-h-60 border-2 border-ink p-6"><span class="ht ht-layer"></span><span class="lbl relative">03</span><span class="disp relative mt-10 block text-5xl leading-none"><T es="Gustos" en="Likes" /></span><span class="relative mt-4 block max-w-[24ch] text-[15px]"><T es="Música, lecturas, comida y manías. Con reproductor." en="Music, reading, food and habits. With a player." /></span><span class="lbl relative mt-6 block transition-transform group-hover:translate-x-2" aria-hidden="true">→</span></a></li><li class="rv sm:col-span-2 lg:col-span-1"><a href="/diario" class="cut bg-deep text-onblue group relative block min-h-60 border-2 border-ink p-6"><span class="ht ht-layer"></span><span class="lbl relative">04</span><span class="disp relative mt-10 block text-5xl leading-none"><T es="Diario" en="Journal" /></span><span class="relative mt-4 block max-w-[24ch] text-[15px]"><T es="Seis notas cortas. Se abren en una ventana." en="Six short notes. They open in a window." /></span><span class="lbl relative mt-6 block transition-transform group-hover:translate-x-2" aria-hidden="true">→</span></a></li></ul></section>
