---
/** Modal accesible controlado por Alpine (componente "diary" en scripts/alpine.js). */
interface Props { id: string; labelledby: string }
const { id, labelledby } = Astro.props;
---
<div x-show={`open === '${id}'`} x-cloak x-transition.opacity data-modal={id} class="modal-wrap" role="dialog" aria-modal="true" aria-labelledby={labelledby}>
  <div class="absolute inset-0 bg-paper2 opacity-90" x-on:click="hide()"></div>
  <article class="modal-box"><slot /></article>
</div>
