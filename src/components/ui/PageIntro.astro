---
import T from './T.astro';
import { pageByKey, type PageKey } from '../../data/site';
/** Cabecera común de las páginas interiores: señal, título h1 y bajada. */
interface Props { page: PageKey }
const { intro } = pageByKey[Astro.props.page];
---
{intro && (
  <div class="mx-auto max-w-6xl px-4 pt-14 md:pt-20">
    <p class="lbl flex justify-between"><span>SIGNAL {intro.signal}</span><span>日本語 · 信号</span></p>
    <h1 class="disp mt-4 text-[clamp(44px,11vw,128px)] leading-[.9]"><T {...intro.title} /></h1>
    <p class="mt-5 max-w-xl text-lg"><T {...intro.text} /></p>
    {intro.note && <p class="lbl mt-3"><T {...intro.note} /></p>}
  </div>
)}
