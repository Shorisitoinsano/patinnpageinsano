---
import Modal from '../ui/Modal.astro';
import T from '../ui/T.astro';
import type { DiaryEntry } from '../../data/diary';
interface Props { entry: DiaryEntry; index: number }
const { entry, index } = Astro.props;
const titleId = `t${index}`;
---
<Modal id={entry.id} labelledby={titleId}>
  <p class="lbl flex justify-between"><span>{entry.date}</span><span><T {...entry.tag} /></span></p>
  <h2 id={titleId} class="disp modal-title"><T {...entry.title} /></h2>
  {entry.body.map((p) => <p class="mt-5"><T {...p} /></p>)}
  <button type="button" data-close class="btn mt-8" x-on:click="hide()"><T es="Cerrar" en="Close" /> ✕</button>
</Modal>
