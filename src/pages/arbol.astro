---
/** Pantalla secreta (se llega cambiando el tema muchas veces). Usa su propia hoja: no comparte el layout. */
import '@fontsource/libre-bodoni/400-italic.css';
import '@fontsource/libre-bodoni/700-italic.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '../styles/arbol.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>…</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body class="fixed inset-0 overflow-hidden bg-black text-neutral-200">
<a href="/" class="lbl fixed left-5 top-4 z-10 opacity-60 hover:opacity-100">← volver</a>
<main class="absolute inset-0 flex flex-col items-center justify-center gap-6 px-6 pb-10 pt-14">
<img id="tree" src="/assets/arbol.gif" alt="Un árbol pixelado de copa roja y magenta" class="aspect-square h-auto w-[min(66vh,88vw,760px)] opacity-0 [image-rendering:pixelated]">
<h1 id="line" class="max-w-[20em] text-balance text-center font-display text-[clamp(26px,4.6vw,60px)] font-bold italic leading-[1.12] text-white opacity-0 normal-case">The man was waiting for you behind that tree</h1>
</main>
<div id="yt-wrap" class="pointer-events-none fixed bottom-4 right-4 z-[4] h-[124px] w-[220px] border border-neutral-200 bg-black opacity-0"><div id="yt-p" class="h-full w-full"></div></div>
<button id="snd" type="button" class="lbl pointer-events-none fixed bottom-4 left-5 z-10 border border-neutral-200 px-3 py-2 opacity-0">♪ sonido on</button>
<button id="enter" type="button" class="lbl absolute inset-0 z-20 grid h-full w-full place-content-center place-items-center gap-4 bg-black text-neutral-200"><span class="font-display text-[clamp(22px,3.4vw,40px)] font-bold normal-case italic leading-tight tracking-tight">alguien te espera</span><span class="opacity-60">[ pulsa para entrar · con sonido ]</span></button>
<script is:inline src="/js/arbol.js"></script>
</body>
</html>
